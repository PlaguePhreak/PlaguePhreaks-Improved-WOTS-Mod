<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WOTS Mod Installer</AssemblyName>
    <RootNamespace>WotsInstaller</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <Product>WOTS Mod Installer</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../core/*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
    <EmbeddedResource Include="stock.fp" LogicalName="stock.fp" />
  </ItemGroup>
  <Target Name="EmbedCecil" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(NuGetPackageRoot)mono.cecil/0.11.6/lib/net40/Mono.Cecil.dll" LogicalName="embedded.Mono.Cecil.dll" />
    </ItemGroup>
  </Target>
</Project>
